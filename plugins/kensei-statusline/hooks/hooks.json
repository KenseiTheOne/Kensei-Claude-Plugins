{
  "description": "Offer statusline setup once, when the plugin is enabled but statusLine is not configured yet.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/setup-check.py\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
